{
  "name": "toast-mcp-server",
  "version": "0.1.0",
  "description": "MCP server wrapping the Toast POS API for tip-out calculations and reporting",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && python3 -m unittest discover -s skills/stolen-bell-tipout/tests",
    "package:skill": "python3 scripts/package_skill.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldenandPurple/StolenBell.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/GoldenandPurple/StolenBell/issues"
  },
  "homepage": "https://github.com/GoldenandPurple/StolenBell#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "bin": {
    "toast-mcp": "dist/index.js"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
