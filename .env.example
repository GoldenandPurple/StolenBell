# "demo" (default) serves synthetic data and needs no credentials. "live" calls the Toast API.
TOAST_MCP_MODE=demo

# Live mode only. Toast issues these with your API access
# (Toast Web > Integrations > Toast API access > Manage credentials).
# Use the API access URL Toast gives you, e.g. https://ws-api.toasttab.com
TOAST_API_ACCESS_URL=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
# GUID of the restaurant location to report on
TOAST_RESTAURANT_GUID=

# How Toast jobs, categories and service periods map onto the tip-out.
# Defaults to config/tipout.yaml in the install folder; set an absolute path to use another file.
# TIPOUT_CONFIG_PATH=C:/StolenBell/config/tipout.yaml

# "true" adds wage and labor-cost figures to the labor report. Off by default: wages are sensitive.
TOAST_INCLUDE_WAGES=false
